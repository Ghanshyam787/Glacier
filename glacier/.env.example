# ============ Glacier settings ============
# Is file ko ".env" naam se save karo (install.bat khud bana deta hai). Key kisi ko mat dikhana.

# --- ZAROORI: free Gemini key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Tumhara naam (Glacier is naam se bulayega)
USER_NAME=Shyam
USER_ADDRESS=Shyam sir

# --- Model (blank chhodo to theek hai; Glacier khud sahi model dhundh leta hai)
# MODEL_NAME=gemini-3.5-flash-lite

# --- Voice
VOICE_ENABLED=true
# Gentle male awaaz (default). Female chahiye to: en-IN-NeerjaNeural
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=-4%
# Speech model: base (tez) | small (zyada sahi, thoda slow)
WHISPER_MODEL=base
# Hamesha sunta rahe: "Glacier, ..." bolo. Jawab ke baad 15 sec tak bina naam liye bhi sunega.
ALWAYS_LISTEN=true
FOLLOWUP_SECONDS=15

# --- Computer ke kaam
# Kin drives mein Glacier files dhundhe ("|" se alag karo). Blank = C: D: E: F:
# SEARCH_DRIVES=C:\|D:\
# Band karne wale tools: DISABLED_TOOLS=run_command,run_python    DISABLED_CATEGORIES=control,browser
BROWSER_CHANNEL=chrome

# --- Subah ka digest (weather + news + calendar)
HOME_CITY=
DIGEST_ENABLED=true
DIGEST_TIME=08:00

# --- Window autostart par chhupi rahe (tray mein)
START_HIDDEN=false

# --- Phone se control: Telegram (optional)
# @BotFather se bot banao, token yahan daalo. Phir bot ko /start bhejo, wo chat id batayega.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Email (optional): Gmail ke liye "App Password" (2-step verification ON hona chahiye)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# --- Offline backup AI (optional): Ollama install hoga to khud detect ho jata hai
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=llama3.2

# --- Local API server (optional, dusre apps se Glacier use karne ke liye)
API_SERVER_ENABLED=false
